{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm run build:vercel-server",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "contracts/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/arena", "destination": "/index.html" }
  ]
}
