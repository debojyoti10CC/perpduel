# Default dev/start uses a genuine ephemeral local EVM, not a simulated accounting fallback.
# Local EVM state resets when the server restarts; finished records remain in data/.
LEDGER_MODE=local-evm
PORT=3000
HOST=127.0.0.1

# Monad testnet native-MON room escrow. The app can also deploy/register this
# contract from the Testnet setup dialog; deployment always requires wallet approval.
# These are server-only values. Keep the result signer private key off the client.
# ESCROW_RPC_URL=https://testnet-rpc.monad.xyz
# PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# ESCROW_CONTRACT_ADDRESS=0xYourRoomEscrowAddress
# RESULT_SIGNER_PRIVATE_KEY=0xYourDedicatedBackendResultSigner
# Generated signer and escrow config are stored under data/ (gitignored).

# Optional PaperDuel on-chain match ledger (separate from the MON stake escrow).
# Enable only for your own deployed Monad testnet PaperDuel and funded server signer.
# Never put OPERATOR_PRIVATE_KEY in VITE_* variables or commit .env.
# Monad mode consumes operator gas for round registration, roughly 1Hz shared
# drawdown/risk samples, a committed sample plus each order, and settlement/void.
# Use one dedicated operator signer per running server. No public deploy is automatic.
# LEDGER_MODE=monad
# RPC_URL=https://your-monad-testnet-rpc
# EXPECTED_CHAIN_ID=10143
# CONTRACT_ADDRESS=0xYourDeployedPaperDuelAddress
# OPERATOR_PRIVATE_KEY=your_private_server_operator_key
# CONFIRM_TESTNET_DEPLOY=YES
